<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="10dp" /><solid android:color="#FF4F46E5" /><stroke android:width="2dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="10dp" /><solid android:color="#FF3730A3" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="10dp" /><solid android:color="#FF2A2D34" /></shape>
    </item>
</selector>
