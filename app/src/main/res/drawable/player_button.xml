<!-- Native player round buttons: translucent at rest; brighter with a white ring when focused (icons stay white). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#4DFFFFFF" /><stroke android:width="3dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#29FFFFFF" /><stroke android:width="1dp" android:color="#1FFFFFFF" /></shape>
    </item>
</selector>
