<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="rectangle"><corners android:radius="20dp" /><gradient android:angle="0" android:startColor="#FF6366F1" android:endColor="#FF22D3EE" /></shape></item>
            <item><shape android:shape="rectangle"><corners android:radius="20dp" /><stroke android:width="3dp" android:color="#FFFFFFFF" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="20dp" /><gradient android:angle="0" android:startColor="#FF3730A3" android:endColor="#FF0E7490" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="20dp" /><gradient android:angle="0" android:startColor="#FF4F46E5" android:endColor="#FF06B6D4" /></shape>
    </item>
</selector>
