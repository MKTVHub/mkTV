<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#FF343843" /><stroke android:width="3dp" android:color="#FF818CF8" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#FF343843" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#FF2A2D34" /></shape>
    </item>
</selector>
