<?xml version="1.0" encoding="utf-8"?>
<!-- Native player (PlayerActivity): the video, a centre message, and the overlay (title on top; bar, times and buttons below). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:descendantFocusability="blocksDescendants" />

    <TextView
        android:id="@+id/playerMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_message"
        android:gravity="center"
        android:paddingStart="28dp" android:paddingEnd="28dp"
        android:paddingTop="18dp" android:paddingBottom="18dp"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/playerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="top"
            android:background="@drawable/player_scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_gravity="bottom"
            android:background="@drawable/player_scrim_bottom" />

        <!-- Top: title, site and the time of day. 48dp / 32dp keeps clear of TV overscan. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="48dp" android:paddingEnd="48dp"
            android:paddingTop="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playerSite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/playerClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:textColor="#E6FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Bottom: bar, times, buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="38dp" android:paddingEnd="38dp"
            android:paddingBottom="28dp">

            <com.mktvhub.mktv.PlayerBar
                android:id="@+id/playerBar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:nextFocusDown="@id/playerPlay" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp" android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/playerElapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/playerTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp" android:paddingEnd="10dp">

                <ImageButton
                    android:id="@+id/playerRewind"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/player_button"
                    android:contentDescription="Back 10 seconds"
                    android:nextFocusUp="@id/playerBar"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_replay"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/playerPlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/player_button"
                    android:contentDescription="Play or pause"
                    android:nextFocusUp="@id/playerBar"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/playerForward"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/player_button"
                    android:contentDescription="Forward 10 seconds"
                    android:nextFocusUp="@id/playerBar"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_forward_step"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/playerNext"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/player_button"
                    android:contentDescription="Next"
                    android:nextFocusUp="@id/playerBar"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next"
                    android:tint="#FFFFFFFF"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/playerEnds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/playerCaptions"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/player_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusUp="@id/playerBar"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_subtitles"
                        android:tint="#FFFFFFFF" />

                    <TextView
                        android:id="@+id/playerCaptionsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:duplicateParentState="true"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/playerSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/player_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusUp="@id/playerBar"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_speed"
                        android:tint="#FFFFFFFF" />

                    <TextView
                        android:id="@+id/playerSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:duplicateParentState="true"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
