<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FF1A1C21"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton android:id="@+id/btnBack" style="@style/ToolbarButton" android:scaleType="center" android:src="@drawable/ic_back" />
            <ImageButton android:id="@+id/btnForward" style="@style/ToolbarButton" android:scaleType="center" android:src="@drawable/ic_forward" />
            <ImageButton android:id="@+id/btnReload" style="@style/ToolbarButton" android:scaleType="center" android:src="@drawable/ic_refresh" />
            <ImageButton android:id="@+id/btnHome" style="@style/ToolbarButton" android:scaleType="center" android:src="@drawable/ic_home" />

            <EditText
                android:id="@+id/urlField"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/url_field"
                android:hint="Search or enter address"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF7A7F8A"
                android:textSize="16sp" />

            <ImageButton android:id="@+id/btnVoice" style="@style/ToolbarButton" android:contentDescription="Voice search" android:scaleType="center" android:src="@drawable/ic_mic" android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btnStream"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stream_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Play stream in full-screen player"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:visibility="gone">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_play" />
                <TextView android:id="@+id/streamLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:includeFontPadding="false" android:text="Watch full screen" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/streamCount" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="8dp" android:background="@drawable/count_chip" android:gravity="center" android:includeFontPadding="false" android:minWidth="18dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnShield"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/toolbar_button"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:contentDescription="Ad blocking">

                <ImageView
                    android:id="@+id/shieldIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_on" />

                <TextView
                    android:id="@+id/shieldBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/badge"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
            <ImageButton android:id="@+id/btnMenu" style="@style/ToolbarButton" android:contentDescription="Menu" android:scaleType="center" android:src="@drawable/ic_more" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="#FF4F46E5" />
    </LinearLayout>

    <!-- Shield panel: anchored under the shield button -->
    <LinearLayout
        android:id="@+id/shieldPanel"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/panel_bg"
        android:clickable="true"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/panelIcon" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_shield_on" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/panelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Protection on" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/panelSite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="middle" android:singleLine="true" android:textColor="#FF9CA3AF" android:textSize="14sp" />
            </LinearLayout>
            <TextView android:id="@+id/panelToggle" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/pill_on" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="ON" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/stat_bg" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/statAds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ads &amp; trackers" android:textColor="#FF9CA3AF" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/stat_bg" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/statPopups" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pop-ups" android:textColor="#FF9CA3AF" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/stat_bg" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/statRedirects" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Redirects" android:textColor="#FF9CA3AF" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/panelTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#FF9CA3AF" android:textSize="13sp" />
    </LinearLayout>

    <!-- Phone remote: QR code to pair a phone on the same Wi-Fi -->
    <LinearLayout
        android:id="@+id/remotePanel"
        android:layout_width="820dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:clickable="true"
        android:elevation="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="28dp"
        android:visibility="gone">
        <ImageView android:id="@+id/remoteQr" android:layout_width="260dp" android:layout_height="260dp" android:background="#FFFFFFFF" android:padding="10dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="28dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/remoteTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone remote" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" />
            <!-- Three numbered steps, or the help tips: filled in code -->
            <LinearLayout android:id="@+id/remoteSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" />
            <TextView android:id="@+id/remoteWarn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#FFFBBF24" android:textSize="14sp" android:visibility="gone" />
            <TextView android:id="@+id/remoteUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:singleLine="true" android:ellipsize="end" android:textColor="#FF818CF8" android:textIsSelectable="false" android:textSize="13sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:baselineAligned="false" android:orientation="horizontal">
                <TextView android:id="@+id/remoteHelpBtn" android:drawableStart="@drawable/ic_info" android:drawablePadding="10dp" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Help" android:textColor="#FFFFFFFF" android:textSize="15sp" />
                <TextView android:id="@+id/remoteNewCode" android:drawableStart="@drawable/ic_refresh" android:drawablePadding="10dp" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="New code" android:textColor="#FFFFFFFF" android:textSize="15sp" />
                <TextView android:id="@+id/remoteWifi" android:drawableStart="@drawable/ic_wifi" android:drawablePadding="10dp" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Share Wi-Fi" android:textColor="#FFFFFFFF" android:textSize="15sp" />
            </LinearLayout>
            <TextView android:id="@+id/remoteClose" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginTop="6dp" android:background="@null" android:clickable="false" android:focusable="false" android:gravity="center_vertical" android:paddingStart="0dp" android:paddingEnd="0dp" android:textColor="#FF9CA3AF" android:textSize="14sp" android:text="Back to close" />
        </LinearLayout>
    </LinearLayout>

    <!-- Share Wi-Fi: a "join this network" QR code for guests' phones -->
    <LinearLayout
        android:id="@+id/wifiPanel"
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:clickable="true"
        android:elevation="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="28dp"
        android:visibility="gone">
        <FrameLayout android:layout_width="260dp" android:layout_height="260dp" android:background="#FFFFFFFF">
            <ImageView android:id="@+id/wifiQr" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" />
            <TextView android:id="@+id/wifiQrEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="Type the network name to make the code" android:textColor="#FF6B7280" android:textSize="15sp" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="28dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share Wi-Fi" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Guests scan this with their phone's camera to join your Wi-Fi." android:textColor="#FFD1D5DB" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Network name" android:textColor="#FF9CA3AF" android:textSize="13sp" />
            <EditText android:id="@+id/wifiName" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/url_field" android:imeOptions="actionNext|flagNoExtractUi" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="#FFFFFFFF" android:textColorHint="#FF6B7280" android:hint="e.g. Home-WiFi" android:textSize="16sp" />
            <TextView android:id="@+id/wifiDetect" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Fill in this TV's network" android:textColor="#FFFFFFFF" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Password (leave empty for an open network)" android:textColor="#FF9CA3AF" android:textSize="13sp" />
            <EditText android:id="@+id/wifiPass" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/url_field" android:imeOptions="actionDone|flagNoExtractUi" android:inputType="textVisiblePassword" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="#FFFFFFFF" android:textColorHint="#FF6B7280" android:hint="Wi-Fi password" android:textSize="16sp" />
            <TextView android:id="@+id/wifiHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#FF9CA3AF" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overflow menu (like a phone browser's ⋮ menu). Scrolls on short (540dp) TV screens so every row stays visible. -->
    <ScrollView
        android:id="@+id/menuScroll"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/panel_bg"
        android:elevation="16dp"
        android:focusable="false"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/menuPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>

    <!-- Address-bar suggestions: placed under the address field in code -->
    <LinearLayout
        android:id="@+id/suggestPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="60dp"
        android:background="@drawable/panel_bg"
        android:clickable="true"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- Home screen: Popular, Favourites, Recently visited -->
    <FrameLayout
        android:id="@+id/shortcutsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="@drawable/home_bg"
        android:clickable="true"
        android:visibility="gone">

        <ScrollView android:id="@+id/shortcutsScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="64dp" android:paddingTop="28dp" android:paddingEnd="64dp" android:paddingBottom="48dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/homeTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Home" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:id="@+id/homeRemote" android:drawableStart="@drawable/ic_phone" android:drawablePadding="10dp" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="10dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Phone remote" android:textColor="#FFFFFFFF" android:textSize="16sp" />
                    <TextView android:id="@+id/homeHistory" android:drawableStart="@drawable/ic_history" android:drawablePadding="10dp" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="10dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="History" android:textColor="#FFFFFFFF" android:textSize="16sp" />
                    <TextView android:id="@+id/homePrivate" android:drawableStart="@drawable/ic_private" android:drawablePadding="10dp" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="10dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Private browsing" android:textColor="#FFFFFFFF" android:textSize="16sp" />
                    <TextView android:id="@+id/shortcutsClose" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="✕" android:textColor="#FFFFFFFF" android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/updateCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/update_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp" android:visibility="gone">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_update" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/updateTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:id="@+id/updateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFC7D2FE" android:textSize="14sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/updateLater" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="12dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Later" android:textColor="#FFFFFFFF" android:textSize="15sp" />
                    <TextView android:id="@+id/updateGo" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="10dp" android:background="@drawable/seg_on" android:clickable="true" android:focusable="true" android:gravity="center" android:minWidth="120dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="Update" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView android:id="@+id/privateInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/private_card" android:lineSpacingExtra="4dp" android:padding="20dp" android:textColor="#FFE9E5FF" android:textSize="15sp" android:visibility="gone" />

                <LinearLayout android:id="@+id/popularSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="22dp" android:paddingBottom="14dp">
                    <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:paddingTop="0dp" android:paddingBottom="0dp" android:text="POPULAR" />
                    <TextView android:id="@+id/popularEdit" android:layout_width="wrap_content" android:drawableStart="@drawable/ic_edit" android:drawablePadding="8dp" android:layout_height="36dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Edit" android:textColor="#FFFFFFFF" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/popularTools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="horizontal" android:visibility="gone" />
                <TextView android:id="@+id/popularEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp" android:text="No sites here. Press Edit to add some." android:textColor="#FF9CA3AF" android:textSize="15sp" android:visibility="gone" />
                <GridLayout android:id="@+id/popularGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="8" />
                <LinearLayout android:id="@+id/popularAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="8dp" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Press ✕ on a tile to remove it · Add more:" android:textColor="#FF9CA3AF" android:textSize="14sp" />
                    <GridLayout android:id="@+id/popularSuggest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="6" />
                    <EditText android:id="@+id/popularAddField" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/add_field" android:hint="Or type an address, e.g. example.com" android:imeOptions="actionDone" android:inputType="textUri" android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" android:textColor="#FFFFFFFF" android:textColorHint="#FF7A7F8A" android:textSize="16sp" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/favSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="22dp" android:paddingBottom="14dp">
                    <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:paddingTop="0dp" android:paddingBottom="0dp" android:text="FAVOURITES" />
                    <TextView android:id="@+id/shortcutsEdit" android:layout_width="wrap_content" android:drawableStart="@drawable/ic_edit" android:drawablePadding="8dp" android:layout_height="36dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Edit" android:textColor="#FFFFFFFF" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/favTools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="horizontal" android:visibility="gone" />

                <LinearLayout android:id="@+id/addRow" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText
                        android:id="@+id/addField"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/add_field"
                        android:hint="Add a favourite: type an address, e.g. example.com"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#FF7A7F8A"
                        android:textSize="16sp" />
                    <TextView android:id="@+id/addThisPage" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="10dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="☆ Add this page" android:textColor="#FFFFFFFF" android:textSize="16sp" />
                </LinearLayout>
                <GridLayout android:id="@+id/shortcutsGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="5" />
                <TextView android:id="@+id/shortcutsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:gravity="center" android:padding="24dp" android:text="No favourites yet. Open a site and press ☆ in the toolbar, or type an address above." android:textColor="#FF9CA3AF" android:textSize="16sp" android:visibility="gone" />
                </LinearLayout>

                <LinearLayout android:id="@+id/recentSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/recentTitle" style="@style/SectionTitle" android:text="RECENTLY VISITED" />
                <GridLayout android:id="@+id/recentGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="5" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Settings: full-screen panel -->
    <FrameLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="#FF101217"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="72dp" android:paddingTop="28dp" android:paddingEnd="72dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Settings" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:id="@+id/settingsDone" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@null" android:clickable="false" android:focusable="false" android:gravity="center_vertical" android:paddingStart="0dp" android:paddingEnd="0dp" android:textColor="#FF9CA3AF" android:textSize="14sp" android:text="Saved automatically · Back to close" />
            </LinearLayout>
            <!-- Sections on the left (focusing one shows it), the chosen section's settings on the right -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" android:orientation="horizontal">
                <ScrollView android:id="@+id/settingsNavScroll" android:layout_width="260dp" android:layout_height="match_parent" android:scrollbars="none">
                    <LinearLayout android:id="@+id/settingsNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp" />
                </ScrollView>
                <ScrollView android:id="@+id/settingsScroll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="32dp" android:layout_weight="1" android:scrollbars="none">
                    <LinearLayout android:id="@+id/settingsContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="48dp" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- History: full-screen panel, searchable -->
    <FrameLayout
        android:id="@+id/historyPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="#FF101217"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="160dp" android:paddingTop="28dp" android:paddingEnd="160dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="History" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:id="@+id/historyClear" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="10dp" android:background="@drawable/btn_danger" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Clear history" android:textColor="#FFFCA5A5" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/historyDone" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@null" android:clickable="false" android:focusable="false" android:gravity="center_vertical" android:paddingStart="0dp" android:paddingEnd="0dp" android:textColor="#FF9CA3AF" android:textSize="14sp" android:text="Back to close" />
            </LinearLayout>
            <EditText
                android:id="@+id/historySearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/add_field"
                android:hint="Search history"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF7A7F8A"
                android:textSize="16sp" />
            <ScrollView android:id="@+id/historyScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:scrollbars="none">
                <LinearLayout android:id="@+id/historyContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="48dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Downloads: full-screen panel, rows built in DownloadCenter -->
    <FrameLayout
        android:id="@+id/downloadsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="#FF101217"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="160dp" android:paddingTop="28dp" android:paddingEnd="160dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Downloads" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:id="@+id/downloadsClear" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="10dp" android:background="@drawable/btn_danger" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Clear list" android:textColor="#FFFCA5A5" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:clickable="false" android:focusable="false" android:gravity="center_vertical" android:textColor="#FF9CA3AF" android:textSize="14sp" android:text="Back to close" />
            </LinearLayout>
            <ScrollView android:id="@+id/downloadsScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" android:scrollbars="none">
                <LinearLayout android:id="@+id/downloadsContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="48dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Watch mode: key hints that slide up for a moment, then get out of the way -->
    <LinearLayout
        android:id="@+id/watchDock"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/dock_bg"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/watchFlash"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="@drawable/flash_bg"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp"
        android:visibility="gone" />

    <!-- Bottom bar for blocked pop-ups / redirects, with an escape hatch -->
    <LinearLayout
        android:id="@+id/snackbar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/panel_bg"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp"
        android:visibility="gone">
        <ImageView android:id="@+id/snackIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_shield_on" />
        <TextView android:id="@+id/snackText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:maxWidth="560dp" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/snackAction" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="16dp" android:background="@drawable/toolbar_button" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Open anyway" android:textColor="#FFA5B4FC" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/snackClose" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="✕" android:textColor="#FF9CA3AF" android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />

    <com.mktvhub.mktv.CursorView
        android:id="@+id/cursor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
